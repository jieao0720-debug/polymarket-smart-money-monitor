# ============================================================================
# Polymarket Smart Money Quant Monitor — environment template
# Copy to backend/.env (NEVER commit a real .env — .gitignore enforces this).
# No real secrets belong in this file.
# ============================================================================

# --- trading safety (defaults are the SAFE values; do not flip casually) ---
# Live order submission. MUST stay false until you have read /docs/risk-control.md.
ENABLE_LIVE_TRADING=false
MAX_TRADE_NOTIONAL=100
MAX_SLIPPAGE_BPS=100
MAX_SPREAD_BPS=300
MIN_LIQUIDITY=1000
MIN_POSITION_VALUE=100
TICKET_TTL_MINUTES=10
# Official close-only regions (docs.polymarket.com/api-reference/geoblock)
CLOSE_ONLY_COUNTRIES=PL,SG,TH,TW
# Dev/test ONLY ("", OK, CLOSE_ONLY, BLOCKED). MUST be empty in production.
GEOBLOCK_FORCE_MODE=

# --- database ---
# Local default: sqlite (zero setup). Postgres example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polymarket_monitor
DATABASE_URL=sqlite+aiosqlite:///./data/polymarket_monitor.db

# --- Polymarket API bases (production defaults) ---
POLYMARKET_API_BASE=https://polymarket.com
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_BASE=https://data-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYGON_RPC_URL=https://polygon-rpc.com

# --- scanner ---
SCANNER_MAX_MARKETS=15
SCANNER_MARKET_FETCH_LIMIT=100
SCANNER_MIN_VOLUME_24H=5000
SCANNER_MIN_HOURS_TO_RESOLUTION=6
# 0 disables the APScheduler periodic scan (manual POST /api/scanner/run only)
SCANNER_INTERVAL_MINUTES=0
NEAR_RESOLUTION_HOURS=48
HOLDERS_PER_SIDE=20
EXTERNAL_CONCURRENCY=8
ACCOUNT_HISTORY_MAX_PAGES=4
ACCOUNT_STATS_CACHE_HOURS=6

# --- smart money ---
SMART_MONEY_SCORE_THRESHOLD=60
MIN_SMART_NOTIONAL=500
PAPER_TRADE_AUTO_LOG=true
PAPER_TRADE_MIN_CONFIDENCE=50
# A9b guard: skip auto paper trades when spread/entry > this ratio (and always skip
# EXTREME_PRICE-flagged signals) — prevents spread cost from masquerading as signal PnL
PAPER_TRADE_MAX_RELATIVE_SPREAD=0.10
PAPER_TRADE_DEFAULT_NOTIONAL=100

# --- http / cors ---
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRIES=3
CORS_ORIGINS=http://localhost:3000

# --- frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE=http://localhost:8000
